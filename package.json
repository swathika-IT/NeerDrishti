{
  "name": "neerdrishti",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && esbuild scripts/bootstrap_db.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/bootstrap.cjs",
    "start": "node dist/bootstrap.cjs && node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/regression_risk_forecast.test.ts",
    "test:ai": "tsx --test tests/citizen_brief.test.ts tests/district_features.test.ts tests/api_json_contract.test.ts tests/notification_preview.test.ts",
    "test:auth": "tsx --test tests/auth_security.test.ts",
    "test:reports": "tsx --test tests/report_security.test.ts",
    "test:forecast": "tsx --test tests/forecast_validation.test.ts",
    "test:open-meteo": "tsx --test tests/open_meteo.test.ts",
    "test:cap": "tsx --test tests/cap_feed.test.ts",
    "test:notifications": "tsx --test tests/notification_dry_run.test.ts",
    "test:email": "tsx --test tests/email_delivery.test.ts",
    "test:hardening": "tsx --test tests/production_hardening.test.ts",
    "test:historical": "tsx --test tests/historical_import.test.ts",
    "import:historical": "tsx scripts/import_historical_rainfall.ts",
    "validate:events": "tsx scripts/validate_flood_events.ts",
    "report:validation": "tsx scripts/forecast_validation_report.ts",
    "migrate": "tsx src/db/migrate.ts",
    "db:backup": "tsx scripts/backup_database.ts",
    "db:integrity": "tsx scripts/check_database_integrity.ts",
    "bootstrap": "tsx scripts/bootstrap_db.ts",
    "build:features": "tsx scripts/build_district_features.ts",
    "db:audit-notifications": "tsx scripts/audit_notification_duplicates.ts",
    "pipeline": "python -m scripts.pipeline.cli",
    "test:py": "python -m pytest tests/py -q",
    "test:sim": "tsx --test tests/notification_simulator.test.ts tests/pipeline_contract.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/leaflet": "^1.9.22",
    "@types/nodemailer": "^8.0.2",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "mongodb": "^6.11",
    "motion": "^12.23.24",
    "nodemailer": "^10.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
