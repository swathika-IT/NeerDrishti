# NeerDrishti environment configuration example.
# Copy this file to .env for local development. Never commit .env.

APP_BASE_URL=http://localhost:3000
NODE_ENV=development

# LLM (Llama via an OpenAI-compatible endpoint, e.g. Ollama)
LLM_PROVIDER=llama
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MODEL=llama3.2:3b
LIVE_DATA_REFRESH_MINUTES=30

# IMD official API (api.imd.gov.in) — required only for IMD AWS/district rainfall integration.
IMD_API_KEY=

# National Water Data Portal (NWDP) — historical IMD district-wise daily rainfall CSV.
NWDP_ENABLED=false

# MongoDB connection string (required by the application runtime).
MONGODB_URI=
# Staging/import safety: when true, application reference-data seeding is disabled
# so the SQLite importer can populate an empty target first. Set false after import.
NEERDRISHTI_STAGING_IMPORT_MODE=true
# Reference-data seeding is opt-in in production. Leave false during staging imports.
NEERDRISHTI_SEED_REFERENCE_DATA=false

# SQLite source used ONLY by migration/import scripts; the app runtime does not use it.
SQLITE_SOURCE_PATH=D:/downloadable/neerdrishti---urban-flood-intelligence/data/neerdrishti.db
# Legacy SQLite settings retained for source/import tooling only.
DATABASE_PATH=data/neerdrishti.db
NEERDRISHTI_BACKUP_DIR=backups

# HMR: set true only to disable Vite file watching.
DISABLE_HMR=false

# --- Authentication (Phase 5) ---
PORT=3000
COOKIE_SECURE=
AUTH_DEV_EXPOSE_TOKENS=false

# --- Citizen report submission rate limits (Phase 6) ---
REPORT_RATE_LIMIT_MAX=10
REPORT_RATE_LIMIT_USER_MAX=20
CLASSIFIER_FORCE_RULE_BASED=false

# --- Official CAP warning feeds (Phase 8 / Epic 4) ---
IMD_CAP_ENABLED=true
IMD_CAP_RSS_URL=https://cap-sources.s3.amazonaws.com/in-imd-en/rss.xml
SACHET_CAP_ENABLED=true
SACHET_CAP_RSS_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_telangana.xml
SACHET_CAP_INCLUDE_ALL_INDIA=true
SACHET_CAP_ALL_INDIA_RSS_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
CAP_TELANGANA_ONLY=true
CAP_REFRESH_MINUTES=15
CAP_TIMEOUT_MS=8000
CAP_RETRIES=2
CAP_RETRY_BACKOFF_MS=300
CAP_MAX_ITEMS=30
CAP_STALE_AFTER_HOURS=24

# --- Notification delivery (Phase 8 / Epic 5) - DRY_RUN ONLY ---
# This release cannot send live email, SMS or WhatsApp messages.
NOTIFICATION_DRY_RUN=true
NOTIFICATION_LIVE_SEND_ENABLED=false
NOTIFICATION_MAX_RETRIES=2
NOTIFICATION_RETRY_BACKOFF_MS=200
NOTIFICATION_RATE_LIMIT_PER_HOUR=10

# SMTP configuration. Missing credentials keep email in DRY_RUN mode.
# Safe placeholder values only. Replace locally; never commit real credentials.
MAIL_DRY_RUN=true
MAIL_FROM="NeerDrishti <your-sender@example.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=

# SMS and WhatsApp adapters are disabled by default and DRY_RUN only.
SMS_ENABLED=false
SMS_DRY_RUN=true
SMS_PROVIDER=generic_http
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

WHATSAPP_ENABLED=false
WHATSAPP_DRY_RUN=true
WHATSAPP_PROVIDER=generic_http
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# --- Open-Meteo live data integration (Phase 8 / Epic 1) ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com
OPEN_METEO_TIMEOUT_MS=8000
OPEN_METEO_RETRIES=2
OPEN_METEO_CACHE_TTL_MS=300000
DUPLICATE_SUPPRESSION_WINDOW_MS=1200000

# Attribution note: Open-Meteo is CC BY 4.0 (non-commercial) and is NOT an official government flood source.

# --- Production hardening (Phase 8 / Epic 6) ---
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=600
SECURITY_CSP_ENABLED=true
SECURITY_HSTS_ENABLED=false
REQUEST_LOG_ENABLED=true
SHUTDOWN_TIMEOUT_MS=5000

# --- Local SMTP one-recipient test script ---
# Required only for scripts/send_smtp_test_email.ts. Never set these for normal app use.
# MAIL_TEST_RECIPIENT=you@example.com
# MAIL_TEST_CONFIRM=SEND_ONE_TEST_EMAIL

# ---- Basemap (optional) ----------------------------------------------------
# Leave MAP_TILE_URL empty to use the built-in local fallback (district polygons + markers, no external requests).
# Set it ONLY to a tile service you are authorised to use, with YOUR key, e.g. MapTiler / Stadia / Thunderforest or self-hosted tiles.
# Do not point this at tile.openstreetmap.org: its usage policy blocks application traffic (HTTP 403).
MAP_TILE_URL=
MAP_TILE_ATTRIBUTION=
MAP_TILE_MAX_ZOOM=14
MAP_TILE_SUBDOMAINS=abc

# ---- Data pipeline (Python scripts; never commit real values) ----------------
# Free key from https://opentopography.org/ (SRTM DEM download)
OPENTOPOGRAPHY_API_KEY=
# Only if a government host has an incomplete TLS chain: path to a PEM bundle that adds the missing intermediate certificate.
# TLS verification is never disabled.
NWDP_CA_BUNDLE=
